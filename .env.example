# Environment Variables Setup

# Next.js Environment
NEXT_PUBLIC_API_URL=http://localhost:3000

# N8N Configuration (Optional - for local development)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/business-analytics
N8N_API_URL=http://localhost:5678/api/v1

# Database (Optional - for future database integration)
DATABASE_URL=mongodb://localhost:27017/business-analytics

# API Keys (Add your own)
OPENAI_API_KEY=your_openai_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
MONGODB_URI=your_mongodb_connection_string_here

# Email Configuration (Optional)
ADMIN_EMAIL=admin@yourbusiness.com
SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
